# Copy to .env and fill in. .env is gitignored.
# All settings use the SOLARA_ prefix and are loaded by solaraalpha.config.

# Where downloaded and derived data lives (default: ./data)
# SOLARA_DATA_DIR=./data

# Logging level: DEBUG, INFO, WARNING, ERROR
# SOLARA_LOG_LEVEL=INFO

# Free-tier API keys go here as they are added, e.g.
# SOLARA_<PROVIDER>_API_KEY=
